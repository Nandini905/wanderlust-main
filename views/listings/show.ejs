 

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-7" data-aos="fade-right">
      <div class="ratio ratio-16x9 mb-3">
        <img src="<%= listing.coverImage || '/images/placeholder-room.jpg' %>" class="rounded-3 w-100 h-100 object-fit-cover shadow-sm" alt="<%= listing.title %>">
      </div>
      <h1 class="h3 mb-1"><%= listing.title %></h1>
      <p class="text-muted mb-3"><i class="bi bi-geo-alt me-1"></i><%= listing.location %></p>
      <p><%= listing.description %></p>

      <hr>
      <h2 class="h5 mb-3">Reviews</h2>
      <div class="vstack gap-3">
        <% (reviews || []).forEach(function(review){ %>
          <div class="border rounded-3 p-3 shadow-sm" data-aos="fade-up">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div class="fw-semibold"><i class="bi bi-person-circle me-1"></i><%= review.author.username %></div>
              <div class="text-warning"><i class="bi bi-star-fill"></i> <%= review.rating %></div>
            </div>
            <p class="mb-0 text-muted"><%= review.comment %></p>
          </div>
        <% }) %>
        <% if ((!reviews || reviews.length === 0) && user) { %>
          <a href="/listings/<%= listing._id %>/reviews/new" class="btn btn-outline-primary align-self-start" data-aos="zoom-in"><i class="bi bi-chat-dots me-2"></i>Write a review</a>
        <% } %>
      </div>
    </div>

    <div class="col-lg-5" data-aos="fade-left">
      <div class="border rounded-3 p-3 sticky-top" style="top: 88px;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="h4 m-0">$<%= listing.pricePerNight %> <small class="text-muted fs-6">night</small></div>
          <div class="text-warning"><i class="bi bi-star-fill"></i> <%= listing.rating || 4.8 %></div>
        </div>
        <form id="bookingForm" class="vstack gap-2">
          <input type="hidden" id="listingId" value="<%= listing._id %>">
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">Check-in</label>
              <input type="date" id="checkIn" class="form-control" required>
            </div>
            <div class="col-6">
              <label class="form-label">Check-out</label>
              <input type="date" id="checkOut" class="form-control" required>
            </div>
          </div>
          <div>
            <label class="form-label">Guests</label>
            <input type="number" min="1" id="guests" class="form-control" value="1" required>
          </div>
          <div class="d-flex justify-content-between small text-muted">
            <span id="nightsLabel">Select dates</span>
            <span id="totalLabel"></span>
          </div>
          <button class="btn btn-primary w-100" type="submit" data-aos="zoom-in"><i class="bi bi-calendar-check me-2"></i>Reserve</button>
          <% if (user && user._id && String(user._id) === String(listing.owner._id)) { %>
            <div class="d-flex gap-2 mt-2">
              <a class="btn btn-outline-secondary w-50" href="/listings/<%= listing._id %>/edit"><i class="bi bi-pencil-square me-1"></i>Edit</a>
              <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="w-50">
                <button class="btn btn-outline-danger w-100" type="submit"><i class="bi bi-trash me-1"></i>Delete</button>
              </form>
            </div>
          <% } %>
        </form>
        <script>
          (function(){
            const pricePerNight = Number(<%= listing.pricePerNight %>);
            const checkInEl = document.getElementById('checkIn');
            const checkOutEl = document.getElementById('checkOut');
            const totalLabel = document.getElementById('totalLabel');
            const nightsLabel = document.getElementById('nightsLabel');
            const form = document.getElementById('bookingForm');

            function calcNights(){
              const ci = new Date(checkInEl.value);
              const co = new Date(checkOutEl.value);
              if (!checkInEl.value || !checkOutEl.value) return 0;
              const ms = co - ci;
              const nights = Math.max(0, Math.ceil(ms / (1000*60*60*24)));
              return nights;
            }

            function updateTotals(){
              const nights = calcNights();
              if (nights > 0){
                nightsLabel.textContent = nights + ' night' + (nights>1?'s':'');
                const total = pricePerNight * nights;
                totalLabel.textContent = 'Total: $' + total.toFixed(2);
              } else {
                nightsLabel.textContent = 'Select dates';
                totalLabel.textContent = '';
              }
            }

            checkInEl.addEventListener('change', updateTotals);
            checkOutEl.addEventListener('change', updateTotals);

            form.addEventListener('submit', async function(e){
              e.preventDefault();
              const listingId = document.getElementById('listingId').value;
              const guests = document.getElementById('guests').value;
              const payload = {
                userId: '<%= (user && user._id) ? String(user._id) : '' %>',
                propertyId: listingId,
                checkIn: checkInEl.value,
                checkOut: checkOutEl.value,
                guests
              };
              try {
                const res = await fetch('/api/bookings', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Failed to create booking');
                alert('Booking created! Total: $' + (data.totalPrice || ''));
                window.location.href = '/bookings/' + data.bookingId;
              } catch (err){
                alert(err.message);
              }
            });
          })();
        </script>
      </div>
    </div>
  </div>
</div>

 

